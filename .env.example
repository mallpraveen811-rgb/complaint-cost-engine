# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# A cheap, fast model is right for tagging. Model names change often:
# copy the exact id from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Requests per minute. Check your free-tier limit in Google AI Studio and stay below it.
GEMINI_RPM=10
