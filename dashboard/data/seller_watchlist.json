 "meta": [
  {
   "label": "SQL (PostgreSQL 16, database complaint_cost)",
   "value": "SELECT left(s.seller_key, 8) AS seller_id, s.seller_state, s.orders, round(s.revenue) AS revenue_brl, s.avg_review_score,\n       s.late_pct, round(100.0*b.bad,1) AS bad_review_pct, s.health_status\nFROM mart.seller_scorecard s\nJOIN (SELECT seller_key, avg((review_score<=2)::int) bad FROM dw.fact_orders GROUP BY 1) b USING (seller_key)\nWHERE s.orders >= 50 ORDER BY b.bad DESC LIMIT 12",
   "type": "code",
   "lang": "sql"
  },
  {
   "label": "Input",
   "value": "Olist Brazilian E-Commerce dataset (Kaggle), 9 CSV files"
  }
 ]
